# ---------------------------------------------------------------------------
# My Growth - environment configuration
#
# Everything the app needs to record and review works with NO configuration.
# The variables below only enable the optional AI review feature.
# ---------------------------------------------------------------------------

# Frontend: URL of the AI proxy endpoint. Leave empty/unset to disable AI and
# use the deterministic local summary instead. This is only an endpoint URL -
# never put a model API key in a VITE_* variable, it would ship to the browser.
VITE_AI_PROXY_URL=

# ---------------------------------------------------------------------------
# Server-side only (read by server/ai-proxy.mjs, never bundled into the client)
# ---------------------------------------------------------------------------

# Model API key. Required to run the proxy.
AI_API_KEY=

# OpenAI-compatible base URL and model name.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Port the proxy listens on, and the browser origin allowed to call it.
AI_PROXY_PORT=8787
AI_ALLOWED_ORIGIN=http://localhost:5173
